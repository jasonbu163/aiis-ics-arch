# ================================================================================
# Syntax | 语法说明
# ================================================================================
#
# 1. 字符串值统一使用双引号包裹
# 2. 布尔值使用 True/False（首字母大写）
# 3. Docker 容器内访问依赖服务时，主机名使用 compose service name
#
# ================================================================================

# ================================================================================
# App | 应用
# ================================================================================
APP_NAME="AIIS ICS Architecture"
APP_VERSION="1.0.0"
APP_DESCRIPTION="AIIS ICS Architecture Core Backend"
API_V1_PREFIX="/api/v1"
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
BACKEND_WORKERS=4

# ================================================================================
# Runtime | 运行模式
# ================================================================================
DEBUG=False
TESTING=False
BACKEND_MOCK_ENABLED=False
# Projection runner uses FastAPI lifespan only; it reads CA raw facts and never opens a PLC connection.
# Keep disabled for ordinary multi-worker API deployment. Enable only in one explicit --workers 1 Projection host.
PROJECTION_RUNNER_ENABLED=False
PROJECTION_RUNNER_INTERVAL_SECONDS=1.0
PROJECTION_RUNNER_BATCH_SIZE=100
# 常见现场示例：马来西亚 "Asia/Kuala_Lumpur"，香港 "Asia/Hong_Kong"。
# prod 文件 bind 原地修改后 restart；原子替换文件需 recreate。
TZ="Asia/Shanghai"

# ================================================================================
# Auth | 认证
# ================================================================================
JWT_SECRET_KEY="change-this-secret-key"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7
# API permission configuration is deployment-owned. admin is code-fixed and must not appear here; invalid JSON denies all non-admin roles.
ROLE_API_PERMISSIONS_JSON='{}'

# ================================================================================
# Logging | 日志
# ================================================================================
LOG_DIR="logs"
LOG_LEVEL="INFO"
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ================================================================================
# Database Routing | 数据库路由
# ================================================================================
# get_db / get_sync_db_context 始终使用 PRIMARY_DATABASE 指向的主业务库。
PRIMARY_DATABASE="mysql"
DATABASE_TYPE="mysql"
MYSQL_ENABLED=True
POSTGRES_ENABLED=False
SQLITE_ENABLED=False
MSSQL_ENABLED=False

# ================================================================================
# MySQL | MySQL
# ================================================================================
# 正式 Compose 不携带 MySQL；这里必须填写外部数据库的真实内网 DNS 或 IP，不能使用 localhost。
# Docker Desktop 复用 database-only 时使用 host.docker.internal:3307；库名/账号与目标一致。
MYSQL_HOST="replace-with-external-mysql-host"
MYSQL_PORT=3306
MYSQL_USER="appuser"
MYSQL_PASSWORD="change-me"
MYSQL_DATABASE="aiis_ics_architecture"
# backend 维护脚本使用的 root 账号，连接地址复用上方 MYSQL_HOST / MYSQL_PORT。
MYSQL_ROOT_USER="root"
MYSQL_ROOT_PASSWORD="change-root-password"

# ================================================================================
# PostgreSQL | PostgreSQL
# ================================================================================
POSTGRES_HOST="postgres"
POSTGRES_PORT=5432
POSTGRES_USER="appuser"
POSTGRES_PASSWORD="change-me"
POSTGRES_DATABASE="aiis_ics_architecture"

# ================================================================================
# SQLite | SQLite
# ================================================================================
SQLITE_DATABASE_PATH="./data/aiis_ics_architecture.sqlite3"

# ================================================================================
# MSSQL | SQL Server
# ================================================================================
MSSQL_HOST="host.docker.internal"
MSSQL_PORT=1433
MSSQL_USER="sa"
MSSQL_PASSWORD="change-me"
MSSQL_DATABASE="aiis_ics_architecture"
MSSQL_DRIVER="ODBC Driver 18 for SQL Server"
MSSQL_TRUST_SERVER_CERTIFICATE=True

# ================================================================================
# Bootstrap | 初始化账号
# ================================================================================
# 正式部署默认不创建默认管理员；首次初始化时显式打开并设置强密码。
ADMIN_BOOTSTRAP_ENABLED=False
ADMIN_BOOTSTRAP_USERNAME="admin"
ADMIN_BOOTSTRAP_PASSWORD=""
ADMIN_BOOTSTRAP_NAME="Administrator"
ADMIN_BOOTSTRAP_ROLE="admin"
ADMIN_BOOTSTRAP_RESET_PASSWORD=False
SUPERVISOR_BOOTSTRAP_ENABLED=False
SUPERVISOR_BOOTSTRAP_USERNAME="supervisor"
SUPERVISOR_BOOTSTRAP_PASSWORD=""
SUPERVISOR_BOOTSTRAP_NAME="Supervisor"
SUPERVISOR_BOOTSTRAP_ROLE="supervisor"
SUPERVISOR_BOOTSTRAP_RESET_PASSWORD=False
OPERATOR_BOOTSTRAP_ENABLED=False
OPERATOR_BOOTSTRAP_USERNAME="operator"
OPERATOR_BOOTSTRAP_PASSWORD=""
OPERATOR_BOOTSTRAP_NAME="Operator"
OPERATOR_BOOTSTRAP_ROLE="operator"
OPERATOR_BOOTSTRAP_RESET_PASSWORD=False
