# ================================================================================
# Syntax
# ================================================================================
# Strings may use single or double quotes. Use True/False for booleans.
# JSON arrays use outer single quotes and inner double quotes, for example: '["monitor"]'.
# Host-source dependencies use 127.0.0.1 and published ports.
# Database-only initializes the application database/account only on an empty volume.

# ================================================================================
# App
# ================================================================================
# Application display name.
APP_NAME="AIIS ICS Architecture"

# Application version reported by API metadata.
APP_VERSION="1.0.0"

# Application description in API metadata.
APP_DESCRIPTION="AIIS ICS Architecture Core Backend"

# Prefix for versioned API routes.
API_V1_PREFIX="/api/v1"

# Uvicorn bind address; container serving normally uses 0.0.0.0.
BACKEND_HOST="127.0.0.1"

# Uvicorn listening port, positive integer.
BACKEND_PORT=8000

# Production Uvicorn worker count; development and packaged entry force one.
BACKEND_WORKERS=1

# ================================================================================
# Runtime
# ================================================================================
# Enable diagnostic error detail; disable for production.
DEBUG=True

# Use the separate MySQL test database and disable the Projection runtime.
TESTING=False

# Allow module Service mock providers or explicit sample seeds.
BACKEND_MOCK_ENABLED=False

# Enable the lifespan Projection runner only on one designated writer host.
PROJECTION_RUNNER_ENABLED=False

# Projection polling interval in seconds, positive number.
PROJECTION_RUNNER_INTERVAL_SECONDS=1.0

# Maximum raw facts per Projection batch, positive integer.
PROJECTION_RUNNER_BATCH_SIZE=100

# Process timezone; restart to apply, without changing database timezone.
TZ="Asia/Shanghai"

# ================================================================================
# Auth
# ================================================================================
# JWT signing secret; replace the public placeholder and keep private.
JWT_SECRET_KEY="replace-with-local-jwt-secret"

# JWT signing and verification algorithm, normally HS256.
JWT_ALGORITHM="HS256"

# Access-token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Refresh-token lifetime in days.
REFRESH_TOKEN_EXPIRE_DAYS=7

# Supervisor API permission keys as a JSON string array; default [] grants none.
SUPERVISOR_API_PERMISSIONS_JSON='[]'

# Operator API permission keys as a JSON string array; must be a supervisor subset.
OPERATOR_API_PERMISSIONS_JSON='[]'

# ================================================================================
# Logging
# ================================================================================
# Directory for JSON Lines log files.
LOG_DIR="logs"

# Log threshold such as DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL="INFO"

# Maximum log-file size before rotation, in bytes.
LOG_MAX_BYTES=10485760

# Number of rotated log backups retained.
LOG_BACKUP_COUNT=5

# ================================================================================
# Database Routing
# ================================================================================
# Primary database selector: mysql, postgresql, sqlite or mssql.
PRIMARY_DATABASE="mysql"

# Legacy database selector used when PRIMARY_DATABASE is empty.
DATABASE_TYPE="mysql"

# Permit selecting MySQL as the primary database.
MYSQL_ENABLED=True

# Permit selecting PostgreSQL as the primary database.
POSTGRES_ENABLED=False

# Permit selecting SQLite as the primary database.
SQLITE_ENABLED=False

# Permit selecting SQL Server as the primary database.
MSSQL_ENABLED=False

# ================================================================================
# MySQL
# ================================================================================
# MySQL host shared by application and root maintenance connections.
MYSQL_HOST="127.0.0.1"

# MySQL TCP port shared by application and root maintenance connections.
MYSQL_PORT=3307

# MySQL application account.
MYSQL_USER="devuser"

# MySQL application password; keep private.
MYSQL_PASSWORD="replace-with-local-mysql-password"

# Primary MySQL application database name.
MYSQL_DATABASE="aiis_ics_architecture"

# MySQL account for root maintenance connections, not application requests.
MYSQL_ROOT_USER="root"

# MySQL root maintenance password; keep private.
MYSQL_ROOT_PASSWORD="replace-with-local-mysql-root-password"

# ================================================================================
# PostgreSQL
# ================================================================================
# PostgreSQL host, required when selected.
POSTGRES_HOST="localhost"

# PostgreSQL TCP port, required when selected.
POSTGRES_PORT=5432

# PostgreSQL application account, required when selected.
POSTGRES_USER="devuser"

# PostgreSQL application password; keep private.
POSTGRES_PASSWORD="replace-with-local-postgres-password"

# PostgreSQL application database name, required when selected.
POSTGRES_DATABASE="aiis_ics_architecture"

# ================================================================================
# SQLite
# ================================================================================
# SQLite database file path.
SQLITE_DATABASE_PATH="./data/aiis_ics_architecture.sqlite3"

# ================================================================================
# MSSQL
# ================================================================================
# SQL Server host.
MSSQL_HOST="host.docker.internal"

# SQL Server TCP port.
MSSQL_PORT=1433

# SQL Server application account.
MSSQL_USER="sa"

# SQL Server application password; keep private.
MSSQL_PASSWORD="replace-with-local-mssql-password"

# SQL Server application database name.
MSSQL_DATABASE="aiis_ics_architecture"

# Installed ODBC driver name for SQL Server.
MSSQL_DRIVER="ODBC Driver 18 for SQL Server"

# Trust the SQL Server certificate without certificate validation.
MSSQL_TRUST_SERVER_CERTIFICATE=True

# ================================================================================
# Bootstrap
# ================================================================================
# Enable this account only for the explicit bootstrap maintenance action.
ADMIN_BOOTSTRAP_ENABLED=False

# Username to locate or create during bootstrap.
ADMIN_BOOTSTRAP_USERNAME="admin"

# Non-empty bootstrap password when enabled; keep private.
ADMIN_BOOTSTRAP_PASSWORD=""

# Display name for a newly created bootstrap account.
ADMIN_BOOTSTRAP_NAME="Administrator"

# Role assigned to a newly created bootstrap account.
ADMIN_BOOTSTRAP_ROLE="admin"

# Allow explicit bootstrap to reset an existing password and reactivate the account.
ADMIN_BOOTSTRAP_RESET_PASSWORD=False

# Enable this account only for the explicit bootstrap maintenance action.
SUPERVISOR_BOOTSTRAP_ENABLED=False

# Username to locate or create during bootstrap.
SUPERVISOR_BOOTSTRAP_USERNAME="supervisor"

# Non-empty bootstrap password when enabled; keep private.
SUPERVISOR_BOOTSTRAP_PASSWORD=""

# Display name for a newly created bootstrap account.
SUPERVISOR_BOOTSTRAP_NAME="Supervisor"

# Role assigned to a newly created bootstrap account.
SUPERVISOR_BOOTSTRAP_ROLE="supervisor"

# Allow explicit bootstrap to reset an existing password and reactivate the account.
SUPERVISOR_BOOTSTRAP_RESET_PASSWORD=False

# Enable this account only for the explicit bootstrap maintenance action.
OPERATOR_BOOTSTRAP_ENABLED=False

# Username to locate or create during bootstrap.
OPERATOR_BOOTSTRAP_USERNAME="operator"

# Non-empty bootstrap password when enabled; keep private.
OPERATOR_BOOTSTRAP_PASSWORD=""

# Display name for a newly created bootstrap account.
OPERATOR_BOOTSTRAP_NAME="Operator"

# Role assigned to a newly created bootstrap account.
OPERATOR_BOOTSTRAP_ROLE="operator"

# Allow explicit bootstrap to reset an existing password and reactivate the account.
OPERATOR_BOOTSTRAP_RESET_PASSWORD=False
