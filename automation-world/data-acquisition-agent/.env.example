# DAA desktop startup is SQLite-only: pnpm tauri dev needs no mode/storage switch.
# DAA 仅使用 SQLite；旧 YAML 是首次空实例的一次性迁入来源，不是运行配置。
# Optional process locators must be absolute. Relative YAML paths below anchor
# to this application's source root, never the profile/env directory or cwd.
# DAA_ENV_FILE=/absolute/path/to/owned.env
# DAA_PROFILE_DIR=/absolute/path/to/owned-profile

# This field-read gate defaults false. Even true never connects or starts on boot.
DAA_PLC_READ_ALLOWED=false

# Exactly two one-time sources. Missing/empty is recorded once; explicit retry
# is available only while the SQLite instance remains empty. Files are never changed.
DAA_PLC_CONFIG_PATH=config/plc_points.yaml
DAA_PLC_SNAPSHOT_POLICY_PATH=config/plc_snapshot_policy.yaml

# PLC/group/point/storage configuration lives in SQLite. Import .db/.udt in the UI
# for full structure, review addresses, then explicitly activate/connect/collect.
# Retired legacy/DB/write/autostart/endpoint/Backend/log-path keys have no effect.
# A legacy_snapshot value in the selected env file is ignored with a notice;
# an explicit process DAA_RUNTIME_MODE=legacy_snapshot is rejected (exit 2).
