# AIIS Data Acquisition Agent public local template.
#
# Every external capability is disabled below. Copy this file to .env for a
# local dry run, then provide a separately reviewed site configuration before
# enabling any PLC or database gate. Never commit that site configuration.

DAA_ACCESS_MODE=database
DAA_BACKEND_BASE_URL=http://127.0.0.1:8000
DAA_BACKEND_PROBE_PATH=/health

# Public example contracts; replace together with site-owned files.
DAA_PLC_CONFIG_PATH=config/plc_points.yaml
DAA_PLC_SNAPSHOT_POLICY_PATH=config/plc_snapshot_policy.yaml

# All PLC access gates are off by default.
DAA_PLC_ENDPOINT_PROBE_ENABLED=false
DAA_PLC_HOST=
DAA_PLC_PORT=
DAA_PLC_RACK=
DAA_PLC_SLOT=
DAA_PLC_CONNECT_TIMEOUT_MS=500
DAA_PLC_SAMPLE_READ_ENABLED=false
DAA_PLC_SAMPLE_READ_AUTOSTART=false
DAA_PLC_DRIVER=rust_snap7
DAA_PLC_SAMPLE_LIMIT=8
DAA_PLC_READ_ALLOWED=false
DAA_PLC_WRITE_ALLOWED=false
DAA_PLC_AUTOSTART_MODE=stopped
DAA_PLC_COLLECTION_ENABLED=false
DAA_PLC_COLLECTION_WRITE_ENABLED=false
DAA_PLC_COLLECTION_LOOP_ENABLED=false
DAA_PLC_COLLECTION_LOOP_AUTOSTART=false
DAA_PLC_COLLECTION_INTERVAL_MS=3000
DAA_PLC_COLLECTION_MAX_CONSECUTIVE_FAILURES=10
DAA_PLC_COLLECTION_COLLECTOR_KEY=control-agent-plc
DAA_PLC_COLLECTION_DEVICE_ID=1
DAA_PLC_CONTRACT_VERSION=local
DAA_PLC_RAW_HOT_RETENTION_DAYS=7

# Database access is off and the URL is intentionally blank.
DAA_DATABASE_ENABLED=false
DAA_DATABASE_URL=
DAA_DATABASE_READ_ONLY=true
DAA_DATABASE_CONNECT_TIMEOUT_MS=1500

# Local diagnostics only; no customer log path is implied.
DAA_EXECUTOR_ID=control-agent-local
DAA_STRUCTURED_LOGS_ENABLED=true
DAA_FILE_LOGS_ENABLED=true
DAA_LOG_DIR=logs
DAA_LOG_LEVEL=info
DAA_LOG_FORMAT=jsonl
DAA_LOG_ROTATION=daily
DAA_AUDIT_LOG_ENABLED=true

# Optional authorization boundary self-test stays local and side-effect free.
DAA_UPPER_SYSTEM_AUTH_ENABLED=false
DAA_UPPER_SYSTEM_AUTH_URL=
DAA_UPPER_SYSTEM_AUTH_TIMEOUT_MS=2000
DAA_HIGH_RISK_AUTH_REQUIRED=true
DAA_AUTH_SELF_TEST_ENABLED=true
DAA_AUTH_SELF_TEST_PROVIDER=local_mock
DAA_AUTH_SELF_TEST_OPERATOR_ID=local-self-test
DAA_AUTH_SELF_TEST_ACTION_SCOPE=authorization.self_test
DAA_AUTH_SELF_TEST_RESOURCE_ID=control-agent
DAA_AUTH_SELF_TEST_PAYLOAD_HASH=sha256:self-test-payload
DAA_AUTH_SELF_TEST_APPROVAL_ID=local-self-test-approval

# Optional absolute overrides; relative ENV_FILE/PROFILE_DIR values are ignored.
# DAA_ENV_FILE=/absolute/reviewed/daa.env
# DAA_PROFILE_DIR=/absolute/isolated/daa-profile
