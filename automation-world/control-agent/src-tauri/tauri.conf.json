{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIIS ICS Control Agent",
  "identifier": "com.aiis.ics.controlagent",
  "version": "0.1.0",
  "build": {
    "features": ["rust-snap7-driver"],
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:15190",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"label":"main","title":"AIIS ICS Control Agent","width":1440,"height":900,"minWidth":960,"minHeight":640}],
    "security": {
      "csp": "default-src 'self' asset:; connect-src ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:"
    }
  },
  "bundle": {"active":true,"icon":["icons/32x32.png","icons/128x128.png","icons/128x128@2x.png","icons/icon.icns","icons/icon.ico"]}
}
