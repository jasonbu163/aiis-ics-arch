{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIIS Device Simulator",
  "version": "0.1.0",
  "identifier": "com.aiis.aw.devicesimulator",
  "build": {
    "beforeDevCommand": {
      "cwd": ".",
      "script": "pnpm dev",
      "wait": false
    },
    "beforeBuildCommand": {
      "cwd": ".",
      "script": "pnpm build",
      "wait": true
    },
    "devUrl": "http://127.0.0.1:15194",
    "frontendDist": "../dist",
    "features": [
      "native-s7"
    ]
  },
  "app": {
    "windows": [
      {
        "title": "AIIS Device Simulator",
        "label": "main",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "maximized": false,
        "fullscreen": false,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "AIIS standalone S7 simulator",
    "longDescription": "Independent S7 PLC simulator with Rust runtime and local configuration."
  }
}
