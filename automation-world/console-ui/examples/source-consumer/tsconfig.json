{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "baseUrl": ".",
    "paths": {
      "@aw-ui": [
        "../../src/ui/index.ts"
      ],
      "vue": [
        "./node_modules/vue"
      ],
      "element-plus": [
        "./node_modules/element-plus"
      ],
      "@element-plus/icons-vue": [
        "./node_modules/@element-plus/icons-vue"
      ]
    },
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "../../src/ui/**/*.ts",
    "../../src/ui/**/*.vue"
  ]
}
