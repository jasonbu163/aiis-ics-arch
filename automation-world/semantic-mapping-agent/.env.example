# SMA reads only this app .env or an explicit absolute SMA_ENV_FILE.
# No PLC, database, target, mapping or simulation I/O is enabled on first launch.
SMA_HTTP_ENABLED=false
SMA_BACKEND_BASE_URL=
# Optional absolute isolated runtime roots:
# SMA_ENV_FILE=/absolute/reviewed/sma.env
# SMA_PROFILE_DIR=/absolute/isolated/sma-profile
