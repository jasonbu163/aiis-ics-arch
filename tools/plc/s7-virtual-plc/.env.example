# S7 virtual PLC tool example configuration.
# Copy to tools/plc/s7-virtual-plc/.env for local overrides.

PLC_SIM_PLC_KEY=PLC_1
# Simulator-owned S7 identity. Both values must match the selected PLC key in plc_points.yaml.
PLC_SIM_RACK=0
PLC_SIM_SLOT=1
PLC_SIM_PORT=1102
PLC_SIM_INTERVAL_SECONDS=1.0
PLC_SIM_PROFILE_XLSX=tools/plc/s7-virtual-plc/inputs/simulation_profile.xlsx
