+        || v["error_key"]
+            .as_str()
+            .is_some_and(|s| s.starts_with("forced_driver_stop"))
+        || v["context"]["error_key"]
+            .as_str()
+            .is_some_and(|s| s.starts_with("forced_driver_stop"))
+        || v["had_forced_driver_stop"].as_bool() == Some(true)
+        || v["context"]["had_forced_driver_stop"].as_bool() == Some(true)
