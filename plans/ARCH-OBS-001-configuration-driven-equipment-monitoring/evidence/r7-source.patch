+"""指标写入的类型、身份与省略语义回归。"""
+from datetime import datetime, timedelta
+
+import pytest
+
+from app.equipment_observation.domain import ObservationError, scalar, task_no
+from app.equipment_observation.profile import parse_profile
+from app.equipment_observation.services.ingest import normalize
+from app.equipment_observation.services.reads import freshness
+
+pytestmark = pytest.mark.no_db
+
+
+def producer():
+    return {"producerId": "vendor-1", "kind": "external", "sourceId": "source-1",
+            "mappingId": "mapping-1", "mappingRevision": "r1",
+            "grants": [{"equipmentId": "line-1", "groupKey": "temperature", "target": target,
+                        "metricKeys": ["actual"]} for target in ("latest", "history")]}
+
+
+def body():
+    return {"sourceRefs": [{"kind": "external_event", "sourceEventId": "sample-1"}],
+            "data": {"taskNo": " 00a-1 ", "sampledAt": "2026-11-11T08:00:00.123+08:00",
+                     "values": {"actual": 0}}}
+
+
+def test_task_no_ascii_and_numeric_domain():
+    assert task_no(" 00a-1 ") == "00A-1"
+    assert scalar(0, "number") == 0
+    assert scalar(False, "boolean") is False
+    for invalid in ("ß", "中文", ""):
+        with pytest.raises(ObservationError):
+            task_no(invalid)
+    for invalid in (10**400, 2**65, float("inf"), True):
+        with pytest.raises(ObservationError):
+            scalar(invalid, "number")
+
+
+def test_external_normalization_distinguishes_targets_and_null():
+    first = normalize(body(), producer(), "latest")
+    second = normalize(body(), producer(), "latest")
+    assert first["eventId"] == second["eventId"]
+    assert first["taskNo"] == "00A-1"
+    assert first["quality"] == "unknown"
+    assert first["sourceRefs"][0]["sourceId"] == "source-1"
+    history = body()
+    history["data"]["quality"] = "good"
+    assert normalize(history, producer(), "history")["eventId"] != first["eventId"]
+    for field in ("eventId", "mappingId"):
+        invalid = body()
+        invalid[field] = None
+        with pytest.raises(ObservationError):
+            normalize(invalid, producer(), "latest")
+    invalid = body()
+    invalid["data"]["values"]["actual"] = None
+    with pytest.raises(ObservationError):
+        normalize(invalid, producer(), "latest")
+    with pytest.raises(ObservationError):
+        normalize(body(), producer(), "history")
+
+
+def test_profile_rejects_nonstring_uuid():
+    profile = {"target": {"serverUuid": 123, "schema": "fixture", "schemaRevision": "5f7a9c1e3b26"},
+               "devices": [], "readScopes": {}, "producers": [], "historyRules": [], "groupSettings": []}
+    with pytest.raises(ValueError):
+        parse_profile(profile)
+
+
+def test_group_specific_stale_threshold_is_independent_of_task_age():
+    now = datetime(2026, 11, 11, 9, 30, 30)
+    observed = now - timedelta(seconds=20)
+    profile = {"target": {"serverUuid": "c9a8a3ed-dd91-11f1-8e90-e27dd38db63b", "schema": "fixture", "schemaRevision": "5f7a9c1e3b26"},
+               "devices": [{"equipmentId": "line-1", "nameZh": "产线", "nameEn": "Line", "plcId": "plc-1", "dbNumber": 1,
+                            "taskPointId": "task", "idleValue": "", "maxTaskAgeSeconds": 90}],
+               "readScopes": {}, "producers": [], "historyRules": [],
+               "groupSettings": [{"equipmentId": "line-1", "groupKey": "temperature", "staleAfterSeconds": 10},
+                                 {"equipmentId": "line-1", "groupKey": "drive", "staleAfterSeconds": 30}]}
+    groups = parse_profile(profile)["groupSettings"]
+    assert freshness(now, observed, groups[("line-1", "temperature")]) == "stale"
+    assert freshness(now, observed, groups[("line-1", "drive")]) == "fresh"
+    assert freshness(now, observed, None) == "stale"
