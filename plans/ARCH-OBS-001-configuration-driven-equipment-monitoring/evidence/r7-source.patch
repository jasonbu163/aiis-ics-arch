index 0000000..d867414
--- /dev/null
+++ b/backend/app/equipment_observation/services/ingest.py
@@ -0,0 +1,228 @@
+"""实时快照和过程历史的事务、去重及持久回执。"""
+from sqlalchemy import select
+from sqlalchemy.exc import IntegrityError
+
+from app.plc_facts.services.observation_evidence import EvidenceUnavailable, confirm_task, probe_target
+from ..domain import ObservationError, digest, identifier, reject, sampled_time, scalar, task_no, wire_time
+from ..models import HistorySample, LatestSnapshot, MetricConfig, Receipt, SlotBinding
+from ..profile import permitted
+
+
+def _fields(value, required, allowed):
+    if not isinstance(value, dict) or not required.issubset(value) or not set(value).issubset(allowed):
+        reject()
+
+
+def normalize(document, producer, target):
+    outer = {"contractVersion", "producerId", "eventId", "mappingId", "mappingRevision", "sourceRefs", "data"}
+    _fields(document, {"sourceRefs", "data"}, outer)
+    if any(value is None for key, value in document.items() if key != "data"):
+        reject()
+    if producer["kind"] == "sma" and set(document) != outer:
+        reject()
+    if document.get("contractVersion", "aiis.metric-ingest/v1") != "aiis.metric-ingest/v1":
+        reject("contract_version")
+    if document.get("producerId", producer["producerId"]) != producer["producerId"]:
+        reject("forbidden", 403)
+    pair_present = ("mappingId" in document, "mappingRevision" in document)
+    if pair_present[0] != pair_present[1]:
+        reject()
+    if pair_present[0]:
+        identifier(document["mappingId"])
+        identifier(document["mappingRevision"], 32)
+    data = document["data"]
+    allowed_data = {"equipmentId", "groupKey", "taskNo", "sampledAt", "quality", "values"}
+    required_data = {"taskNo", "sampledAt", "values"}
+    if producer["kind"] == "sma":
+        required_data = allowed_data
+    _fields(data, required_data, allowed_data)
+    if any(value is None for key, value in data.items() if key != "quality"):
+        reject()
+    if producer["kind"] == "sma" and data.get("quality") is None:
+        reject("quality")
+    pairs = {(grant["equipmentId"], grant["groupKey"]) for grant in producer["grants"]}
+    if "equipmentId" not in data or "groupKey" not in data:
+        if producer["kind"] != "external" or len(pairs) != 1:
+            reject()
+        fixed_equipment, fixed_group = next(iter(pairs))
+    else:
+        fixed_equipment = fixed_group = None
+    equipment = identifier(data.get("equipmentId", fixed_equipment))
+    group = identifier(data.get("groupKey", fixed_group))
+    allow = permitted(producer, equipment, group, target)
+    quality = data.get("quality")
+    if quality is None and target == "latest" and producer["kind"] == "external":
+        quality = "unknown"
+    if quality not in ("good", "bad", "unknown") or target == "history" and quality != "good":
+        reject("quality")
+    values = data["values"]
+    if not isinstance(values, dict) or not 1 <= len(values) <= 100:
+        reject("values")
+    for key, value in values.items():
+        identifier(key)
+        if value is None:
+            reject("values")
+    refs = document["sourceRefs"]
+    if not isinstance(refs, list) or not 1 <= len(refs) <= 128:
+        reject("source_refs")
+    refs = [dict(ref) if isinstance(ref, dict) else reject("source_refs") for ref in refs]
+    if producer["kind"] == "external":
+        if len(refs) != 1:
+            reject("source_refs")
+        ref = refs[0]
+        _fields(ref, {"kind", "sourceEventId"}, {"kind", "sourceId", "sourceEventId", "observedAt"})
+        if ref["kind"] != "external_event" or any(v is None for v in ref.values()):
+            reject("source_refs")
+        if ref.get("sourceId", producer["sourceId"]) != producer["sourceId"]:
+            reject("forbidden", 403)
+        ref["sourceId"] = identifier(producer["sourceId"], 128)
+        identifier(ref["sourceEventId"], 128)
+        if "observedAt" in ref:
+            sampled_time(ref["observedAt"])
+        source_key = [ref["sourceId"], ref["sourceEventId"]]
+    else:
+        allowed_ref = {"kind", "instanceId", "plcId", "sampleId", "pointId", "sourceGeneration", "configRevision", "observedAt"}
+        required_ref = {"kind", "instanceId", "plcId", "sampleId", "pointId"}
+        for ref in refs:
+            _fields(ref, required_ref, allowed_ref)
+            if ref["kind"] != "plc_fact" or any(v is None for v in ref.values()):
+                reject("source_refs")
+            for key, value in ref.items():
+                if key not in ("kind", "observedAt"):
+                    identifier(value, 128)
+            if "observedAt" in ref:
+                sampled_time(ref["observedAt"])
+        if len({(r["instanceId"], r["plcId"], r["sampleId"]) for r in refs}) != 1:
+            reject("source_refs")
+        if len({(r["instanceId"], r["plcId"], r["sampleId"], r["pointId"]) for r in refs}) != len(refs):
+            reject("source_refs")
+        source_key = [refs[0]["instanceId"], refs[0]["plcId"], refs[0]["sampleId"]]
+    event = document.get("eventId")
+    if event is None:
+        event = "auto-" + digest([producer["producerId"], equipment, group, source_key, target]).hex()
+    identifier(event, 128)
+    stamp = sampled_time(data["sampledAt"])
+    return {"target": target, "producerId": producer["producerId"], "eventId": event,
+            "mappingId": document.get("mappingId"), "mappingRevision": document.get("mappingRevision"),
+            "sourceRefs": refs, "sourceKey": digest(source_key), "equipmentId": equipment,
+            "groupKey": group, "taskNo": task_no(data["taskNo"]), "sampledAt": stamp,
+            "quality": quality, "values": values, "allowed": allow}
+
+
+def fingerprint(data):
+    return digest({key: wire_time(value) if key == "sampledAt" else value
+                   for key, value in data.items() if key not in {"allowed", "sourceKey"}})
+
+
+def receipt_data(receipt):
+    return {"target": receipt.target, "producerId": receipt.producer_id, "eventId": receipt.event_id,
+            "outcome": receipt.outcome, "recordId": str(receipt.result_record_id) if receipt.result_record_id else None}
+
+
+async def ingest(db, profile, producer, target, document):
+    data = normalize(document, producer, target)
+    for attempt in range(3):
+        commit_started = False
+        try:
+            now = await probe_target(db, profile["target"])
+            previous = (await db.execute(select(Receipt).where(
+                Receipt.target == target, Receipt.producer_id == data["producerId"],
+                Receipt.event_id == data["eventId"]).with_for_update())).scalar_one_or_none()
+            if previous is not None:
+                old = dict(data)
+                old["mappingId"] = data["mappingId"] or previous.mapping_id
+                old["mappingRevision"] = data["mappingRevision"] or previous.mapping_revision
+                if fingerprint(old) != bytes(previous.request_digest):
+                    reject("event_conflict", 409)
+                result = receipt_data(previous)
+                await db.rollback()
+                return result
+            if data["mappingId"] is None:
+                data["mappingId"] = producer["mappingId"]
+                data["mappingRevision"] = producer["mappingRevision"]
+            elif (data["mappingId"], data["mappingRevision"]) != (producer["mappingId"], producer["mappingRevision"]):
+                reject("mapping_conflict", 409)
+            device = profile["devices"][data["equipmentId"]]
+            evidence = await confirm_task(db, device, data["taskNo"], data["sampledAt"], data["sourceRefs"], producer["kind"])
+            if not evidence:
+                reject("task_evidence", 409)
+            query = (select(SlotBinding, MetricConfig).join(MetricConfig, MetricConfig.metric_key == SlotBinding.metric_key)
+                     .where(SlotBinding.target == target, SlotBinding.group_key == data["groupKey"],
+                            SlotBinding.metric_key.in_(list(data["values"]))).with_for_update())
+            rows = (await db.execute(query)).all()
+            available = {metric.metric_key: (slot, metric) for slot, metric in rows if slot.enabled}
+            rule = profile["historyRules"].get((data["equipmentId"], data["groupKey"]))
+            if target == "history" and rule is None:
+                reject("forbidden", 403)
+            if (set(data["values"]) - data["allowed"] or set(data["values"]) - set(available)
+                    or target == "history" and set(data["values"]) - set(rule["metricKeys"])):
+                reject("metric_scope")
+            local_values = {}
+            for key, value in data["values"].items():
+                slot, metric = available[key]
+                if metric.source_group_key != data["groupKey"]:
+                    reject("metric_scope")
+                local_values[f"{slot.slot_no:02d}"] = scalar(value, metric.value_type)
+            receipt = Receipt(target=target, producer_id=data["producerId"], event_id=data["eventId"],
+                              request_digest=fingerprint(data), outcome="pending", processed_at=now,
+                              mapping_id=data["mappingId"], mapping_revision=data["mappingRevision"],
+                              source_refs=data["sourceRefs"], task_evidence=evidence)
+            db.add(receipt)
+            await db.flush()
+            model = LatestSnapshot if target == "latest" else HistorySample
+            conditions = [model.equipment_id == data["equipmentId"], model.task_no == data["taskNo"],
+                          model.group_key == data["groupKey"]]
+            if target == "history":
+                conditions += [model.sampled_at == data["sampledAt"], model.source_sample_key == data["sourceKey"]]
+            current = (await db.execute(select(model).where(*conditions).with_for_update())).scalar_one_or_none()
+            outcome = "stored"
+            if current is not None and target == "history":
+                if current.local_values != local_values or current.quality != data["quality"]:
+                    reject("sample_conflict", 409)
+                outcome = "already_stored"
+            elif current is not None and target == "latest" and data["sampledAt"] < current.sampled_at:
+                outcome = "stale"
+            elif current is not None and target == "latest" and data["sampledAt"] == current.sampled_at:
+                if current.local_values != local_values or current.quality != data["quality"]:
+                    reject("sample_conflict", 409)
+                outcome = "already_stored"
+            elif current is not None:
+                current.sampled_at = data["sampledAt"]
+                current.quality = data["quality"]
+                current.source_sample_key = data["sourceKey"]
+                current.ingest_receipt_id = receipt.id
+                current.local_values = local_values
+                current.updated_at = now
+            else:
+                current = model(equipment_id=data["equipmentId"], group_key=data["groupKey"],
+                                task_no=data["taskNo"], sampled_at=data["sampledAt"], quality=data["quality"],
+                                source_sample_key=data["sourceKey"], ingest_receipt_id=receipt.id,
+                                local_values=local_values, created_at=now, updated_at=now)
+                db.add(current)
+                await db.flush()
+            if outcome == "stored":
+                for slot, _metric in rows:
+                    if slot.first_used_at is None:
+                        slot.first_used_at = now
+            receipt.outcome = outcome
+            receipt.result_record_id = current.id
+            await db.flush()
+            result = receipt_data(receipt)
+            commit_started = True
+            await db.commit()
+            return result
+        except IntegrityError:
+            await db.rollback()
+            if commit_started:
+                raise ObservationError(503, "commit_unknown") from None
+            if attempt == 2:
+                raise ObservationError(503, "not_ready") from None
+        except ObservationError:
+            await db.rollback()
+            raise
+        except EvidenceUnavailable:
+            await db.rollback()
+            raise ObservationError(503, "not_ready") from None
+        except Exception:
+            await db.rollback()
+            raise ObservationError(503, "commit_unknown" if commit_started else "not_ready") from None
diff --git a/backend/app/equipment_observation/services/reads.py b/backend/app/equipment_observation/services/reads.py
new file mode 100644
index 0000000..a8f04a3
--- /dev/null
+++ b/backend/app/equipment_observation/services/reads.py
@@ -0,0 +1,189 @@
+"""设备卡片、过程曲线与管理列表的权限内查询。"""
+from datetime import timedelta
+from sqlalchemy import func, or_, select
+
+from app.plc_facts.services.observation_evidence import current_task, probe_target
+from ..domain import reject, sampled_time, task_no, wire_time
+from ..models import CardConfig, CurveGroup, HistorySample, LatestSnapshot, MetricConfig, Receipt, SlotBinding
+from ..profile import allowed_device, allowed_devices
+from .configuration import card_data, curve_data
+
+
+async def _maps(db, target):
+    rows = (await db.execute(select(SlotBinding, MetricConfig).join(
+        MetricConfig, MetricConfig.metric_key == SlotBinding.metric_key).where(SlotBinding.target == target))).all()
+    return {(slot.group_key, f"{slot.slot_no:02d}"): metric for slot, metric in rows}
+
+
+async def _metrics(db):
+    return {row.metric_key: row for row in (await db.execute(select(MetricConfig))).scalars()}
+
+
+def _label(row, language):
+    return row.name_en if language == "en-US" else row.name_zh
+
+
+async def options(profile, user):
+    return [{"equipmentId": key, "nameZh": profile["devices"][key]["nameZh"],
+             "nameEn": profile["devices"][key]["nameEn"]} for key in sorted(allowed_devices(profile, user))]
+
+
+def freshness(now, sampled_at, group_settings):
+    if group_settings is None:
+        return "stale"
+    return "stale" if now - sampled_at > timedelta(seconds=group_settings["staleAfterSeconds"]) else "fresh"
+
+
+async def latest_cards(db, profile, user, equipment, page, language):
+    binding = allowed_device(profile, user, equipment)
+    if page not in ("production", "cleaning", "temperature", "drive"):
+        reject()
+    now = await probe_target(db, profile["target"])
+    task = await current_task(db, binding)
+    configs = (await db.execute(select(CardConfig).where(CardConfig.page_key == page, CardConfig.enabled.is_(True))
+                                .order_by(CardConfig.sort_order, CardConfig.card_key))).scalars().all()
+    metrics = await _metrics(db)
+    slots = (await db.execute(select(SlotBinding).where(SlotBinding.target == "latest"))).scalars().all()
+    by_metric = {(slot.group_key, slot.metric_key): slot for slot in slots}
+    snapshots = {}
+    if task["state"] == "active":
+        rows = (await db.execute(select(LatestSnapshot).where(
+            LatestSnapshot.equipment_id == equipment, LatestSnapshot.task_no == task["taskNo"]))).scalars()
+        snapshots = {row.group_key: row for row in rows}
+    cards = []
+    for card in configs:
+        items = []
+        for item in card.items:
+            if not item["enabled"] or item["metricKey"] not in metrics:
+                continue
+            metric = metrics[item["metricKey"]]
+            slot = by_metric.get((metric.source_group_key, metric.metric_key))
+            sample = snapshots.get(metric.source_group_key)
+            key = f"{slot.slot_no:02d}" if slot is not None else None
+            present = bool(sample is not None and key in sample.local_values)
+            state = "missing"
+            if present:
+                state = freshness(now, sample.sampled_at, profile["groupSettings"].get((equipment, metric.source_group_key)))
+            items.append({"metricKey": metric.metric_key, "label": _label(metric, language),
+                          "value": sample.local_values[key] if present else None, "valueType": metric.value_type,
+                          "unit": metric.unit, "decimals": metric.decimals, "sourceGroupKey": metric.source_group_key,
+                          "sampledAt": wire_time(sample.sampled_at) if present else None, "dataState": state,
+                          "quality": sample.quality if present else None})
+        if items:
+            cards.append({"cardKey": card.card_key, "title": card.title_en if language == "en-US" else card.title_zh,
+                          "items": items})
+    return {"equipmentId": equipment, "taskNo": task.get("taskNo"), "taskState": task["state"], "cards": cards}
+
+
+async def _conditions(db, profile, user, model, equipment=None, group=None, task=None,
+                      start=None, end=None, category=None, metric_key=None):
+    allowed = allowed_devices(profile, user)
+    if equipment is not None:
+        allowed_device(profile, user, equipment)
+    conditions = [model.equipment_id.in_([equipment] if equipment else list(allowed))]
+    if group:
+        conditions.append(model.group_key == group)
+    if task:
+        conditions.append(model.task_no == task_no(task))
+    if start:
+        conditions.append(model.sampled_at >= sampled_time(start))
+    if end:
+        conditions.append(model.sampled_at <= sampled_time(end))
+    if start and end and sampled_time(end) < sampled_time(start):
+        reject("invalid_time_range")
+    if category:
+        groups = select(MetricConfig.source_group_key).where(MetricConfig.category == category)
+        conditions.append(model.group_key.in_(groups))
+    if metric_key:
+        slots = (await db.execute(select(SlotBinding).where(
+            SlotBinding.target == "history", SlotBinding.metric_key == metric_key))).scalars().all()
+        conditions.append(or_(*[
+            (model.group_key == slot.group_key) &
+            (func.json_contains_path(model.local_values, "one", f'$."{slot.slot_no:02d}"') == 1)
+            for slot in slots
+        ]) if slots else False)
+    return conditions
+
+
+async def sample_data(db, row, target, maps=None, details=False):
+    maps = maps if maps is not None else await _maps(db, target)
+    values = []
+    for key, value in row.local_values.items():
+        metric = maps.get((row.group_key, key))
+        if metric is not None:
+            values.append({"metricKey": metric.metric_key, "nameZh": metric.name_zh, "nameEn": metric.name_en,
+                           "value": value, "valueType": metric.value_type, "unit": metric.unit, "decimals": metric.decimals})
+    result = {"id": str(row.id), "equipmentId": row.equipment_id, "groupKey": row.group_key,
+              "taskNo": row.task_no, "sampledAt": wire_time(row.sampled_at), "quality": row.quality,
+              "values": values, "remark": row.remark, "createdAt": wire_time(row.created_at),
+              "updatedAt": wire_time(row.updated_at)}
+    if target == "history":
+        result["reviewMark"] = row.review_mark
+    if details:
+        receipt = await db.get(Receipt, row.ingest_receipt_id)
+        result["sourceRefs"] = receipt.source_refs if receipt else []
+        result["taskEvidence"] = receipt.task_evidence if receipt else None
+        result["mappingId"] = receipt.mapping_id if receipt else None
+        result["mappingRevision"] = receipt.mapping_revision if receipt else None
+        result["producerId"] = receipt.producer_id if receipt else None
+    return result
+
+
+async def samples(db, profile, user, target, filters, page, size):
+    await probe_target(db, profile["target"])
+    model = HistorySample if target == "history" else LatestSnapshot
+    conditions = await _conditions(db, profile, user, model, **filters)
+    total = (await db.execute(select(func.count()).select_from(model).where(*conditions))).scalar_one()
+    sort = (model.sampled_at.desc(), model.id.desc()) if target == "history" else (model.id.desc(),)
+    rows = (await db.execute(select(model).where(*conditions).order_by(*sort).offset((page-1)*size).limit(size))).scalars().all()
+    maps = await _maps(db, target)
+    items = [await sample_data(db, row, target, maps) for row in rows]
+    return {"items": items, "total": total, "page": page, "pageSize": size,
+            "totalPages": (total + size - 1) // size}
+
+
+async def detail(db, profile, user, target, identity):
+    await probe_target(db, profile["target"])
+    model = HistorySample if target == "history" else LatestSnapshot
+    row = (await db.execute(select(model).where(
+        model.id == identity, model.equipment_id.in_(allowed_devices(profile, user))))).scalar_one_or_none()
+    if row is None:
+        reject("not_found", 404)
+    return row, await sample_data(db, row, target, details=True)
+
+
+async def curves(db, profile, user, equipment, category, task, start, end, language):
+    allowed_device(profile, user, equipment)
+    await probe_target(db, profile["target"])
+    if category not in ("temperature", "drive", "cleaning") or not start or not end:
+        reject()
+    configs = (await db.execute(select(CurveGroup).where(CurveGroup.category == category, CurveGroup.enabled.is_(True))
+                                .order_by(CurveGroup.sort_order, CurveGroup.curve_group_key))).scalars().all()
+    metrics = await _metrics(db)
+    slot_rows = (await db.execute(select(SlotBinding).where(SlotBinding.target == "history"))).scalars().all()
+    slots = {(slot.group_key, slot.metric_key): slot for slot in slot_rows}
+    conditions = await _conditions(db, profile, user, HistorySample, equipment=equipment, task=task, start=start, end=end)
+    rows = (await db.execute(select(HistorySample).where(*conditions)
+                             .order_by(HistorySample.sampled_at, HistorySample.id))).scalars().all()
+    groups = []
+    for config in configs:
+        series = []
+        unit = None
+        for item in config.series:
+            if not item["enabled"] or item["metricKey"] not in metrics:
+                continue
+            metric = metrics[item["metricKey"]]
+            slot = slots.get((metric.source_group_key, metric.metric_key))
+            if slot is None:
+                continue
+            unit = metric.unit
+            slot_no = f"{slot.slot_no:02d}"
+            points = [{"sampledAt": wire_time(row.sampled_at), "value": row.local_values.get(slot_no)}
+                      for row in rows if row.group_key == metric.source_group_key]
+            rule = profile["historyRules"].get((equipment, metric.source_group_key))
+            series.append({"metricKey": metric.metric_key, "label": _label(metric, language), "points": points,
+                           "intervalSeconds": rule["intervalSeconds"] if rule else None})
+        groups.append({"curveGroupKey": config.curve_group_key,
+                       "title": config.title_en if language == "en-US" else config.title_zh,
+                       "unit": unit, "series": series})
+    return {"equipmentId": equipment, "taskNo": task, "groups": groups}
