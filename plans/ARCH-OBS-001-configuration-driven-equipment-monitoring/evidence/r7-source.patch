+            </el-table-column>
+          </el-table>
+        </el-tab-pane>
+        <el-tab-pane :label="t('equipment.observation.snapshots')" name="snapshots">
+          <RecordList v-if="active === 'snapshots'" target="latest" />
+        </el-tab-pane>
+      </el-tabs>
