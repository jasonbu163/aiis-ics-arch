@@ -0,0 +1,16 @@
+/** 按来源时间及选样间隔生成曲线断点，不改变原始样本。 */
+export function gapAwarePoints(points, intervalSeconds) {
+  const result = []
+  let previous = null
+  for (const point of points) {
+    const time = Date.parse(point.sampledAt)
+    if (!Number.isFinite(time)) continue
+    if (previous !== null && Number.isFinite(intervalSeconds) && intervalSeconds > 0 &&
+        Math.floor(time / (intervalSeconds * 1000)) - Math.floor(previous / (intervalSeconds * 1000)) > 1) {
+      result.push([previous + 1, null])
+    }
+    result.push([time, point.value])
+    previous = time
+  }
+  return result
+}
