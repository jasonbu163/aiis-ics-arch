+<!-- 单个可配置曲线组，使用来源采集时间和明确的缺样断点。 -->
+<template>
+  <section class="curve-group">
+    <h3>{{ group.title }}</h3>
+    <div ref="element" class="curve-plot" />
+  </section>
+</template>
+
+<script setup>
+import { nextTick, onBeforeUnmount, onMounted, ref, watch } from 'vue'
+import echarts, { getEChartsTheme } from '@/utils/echarts'
+import { formatShanghaiDateTime } from '@/utils/date'
+import { useThemeStore } from '@/store/theme'
+import { gapAwarePoints } from './curveSeries'
+
+const props = defineProps({ group: { type: Object, required: true } })
+const element = ref()
+const theme = useThemeStore()
+let chart
+let observer
+
+function escapeText(value) {
+  return String(value).replace(/[&<>"']/g, char => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char]))
+}
+
+function formatTime(value) {
+  return formatShanghaiDateTime(new Date(value).toISOString())
+}
+
+function render() {
+  if (!element.value) return
+  chart?.dispose()
+  chart = echarts.init(element.value, getEChartsTheme(theme.theme))
+  chart.setOption({
+    tooltip: { trigger: 'axis', formatter: params => {
+      if (!params.length) return ''
+      return [escapeText(formatTime(params[0].axisValue)), ...params.map(item =>
+        `${item.marker}${escapeText(item.seriesName)}: ${escapeText(item.value?.[1] ?? '—')}`)].join('<br>')
+    } },
+    legend: { data: props.group.series.map(item => item.label) },
+    grid: { left: 55, right: 25, top: 45, bottom: 48 },
+    xAxis: { type: 'time', axisLabel: { hideOverlap: true, formatter: value => formatTime(value).slice(11, 19) } },
+    yAxis: { type: 'value', name: props.group.unit || '', scale: true },
+    series: props.group.series.map(item => ({ name: item.label, type: 'line', showSymbol: false,
+      connectNulls: false, data: gapAwarePoints(item.points, item.intervalSeconds) }))
+  })
+}
+onMounted(() => {
+  nextTick(render)
+  observer = new ResizeObserver(() => chart?.resize())
+  observer.observe(element.value)
+})
+watch(() => props.group, () => nextTick(render), { deep: true })
+watch(() => theme.theme, () => nextTick(render))
+onBeforeUnmount(() => { observer?.disconnect(); chart?.dispose() })
+</script>
+
+<style scoped>
+.curve-group { border: 1px solid var(--border-color); border-radius: 8px; padding: 14px; }
+.curve-group h3 { margin: 0; font-size: 15px; }
+.curve-plot { width: 100%; height: 320px; }
+</style>
