        },
        {
          "scope": "shared_sync", "slotNo": 2, "name": "completedLength", "type": "number", "enabled": true,
          "labels": {"zh-CN": "已生产长度", "en-US": "Completed length"}, "unit": "m",
          "performanceOwner": "automated", "planEditable": true, "syncEnabled": true, "isNullable": true,
          "planVisible": true, "performanceVisible": true
        }
      ]
    }
  },
  {
    "id": "plan",
    "method": "POST",
    "path": "/api/v1/integration/plans/upsert",
