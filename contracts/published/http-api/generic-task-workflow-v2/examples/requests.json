  },
  {
    "id": "performance-first",
    "method": "POST",
    "path": "/api/v1/integration/performances/upsert",
    "body": {"taskNo": "GTR3-EXAMPLE-B", "items": {"completedLength": 50}}
  },
  {
    "id": "plan-after-performance",
    "method": "POST",
    "path": "/api/v1/integration/plans/upsert",
