  "components": {
    "schemas": {
      "ExpectedSource": {
        "properties": {
          "instanceId": {
            "type": "string",
            "title": "Instanceid"
          },
          "sourceGeneration": {
            "type": "string",
            "title": "Sourcegeneration"
          },
          "registrationRevision": {
            "type": "string",
            "title": "Registrationrevision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "instanceId",
          "sourceGeneration",
          "registrationRevision"
        ],
        "title": "ExpectedSource"
      },
      "FailureOut": {
        "properties": {
          "code": {
            "type": "integer",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "data": {
            "type": "null",
            "title": "Data"
          },
          "errorCode": {
            "type": "string",
            "title": "Errorcode"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message",
          "errorCode"
        ],
        "title": "FailureOut"
      },
      "PageData": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/SourceOut"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "pageSize": {
            "type": "integer",
            "title": "Pagesize"
          },
          "totalPages": {
            "type": "integer",
            "title": "Totalpages"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "page",
          "pageSize",
          "totalPages"
        ],
        "title": "PageData"
      },
      "PageOut": {
        "properties": {
          "code": {
            "type": "integer",
            "const": 200,
            "title": "Code",
            "default": 200
          },
          "message": {
            "type": "string",
            "const": "success",
            "title": "Message",
            "default": "success"
          },
          "data": {
            "$ref": "#/components/schemas/PageData"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "PageOut"
      },
      "RegistrationData": {
        "properties": {
          "outcome": {
            "type": "string",
            "enum": [
              "created",
              "updated",
              "replaced",
              "unchanged",
              "deleted"
            ],
            "title": "Outcome"
          },
          "source": {
            "$ref": "#/components/schemas/SourceOut"
          }
        },
        "type": "object",
        "required": [
          "outcome",
          "source"
        ],
        "title": "RegistrationData"
      },
      "RegistrationIn": {
        "properties": {
          "sourceType": {
            "type": "string",
            "enum": [
              "daa",
              "external"
            ],
            "title": "Sourcetype"
          },
          "instanceId": {
            "type": "string",
            "title": "Instanceid"
          },
          "plcId": {
            "type": "string",
            "title": "Plcid"
          },
          "sourceGeneration": {
            "type": "string",
            "title": "Sourcegeneration"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "sourceType",
          "instanceId",
          "plcId",
          "sourceGeneration"
        ],
        "title": "RegistrationIn"
      },
      "RegistrationOut": {
        "properties": {
          "code": {
            "type": "integer",
            "const": 200,
            "title": "Code",
            "default": 200
          },
          "message": {
            "type": "string",
            "const": "success",
            "title": "Message",
            "default": "success"
          },
          "data": {
            "$ref": "#/components/schemas/RegistrationData"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "RegistrationOut"
      },
      "ReplacementSource": {
        "properties": {
          "sourceType": {
            "type": "string",
            "enum": [
              "daa",
              "external"
            ],
            "title": "Sourcetype"
          },
          "instanceId": {
            "type": "string",
            "title": "Instanceid"
          },
          "sourceGeneration": {
            "type": "string",
            "title": "Sourcegeneration"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "sourceType",
          "instanceId",
          "sourceGeneration"
        ],
        "title": "ReplacementSource"
      },
      "SourceOut": {
        "properties": {
          "sourceType": {
            "type": "string",
            "enum": [
              "daa",
              "external"
            ],
            "title": "Sourcetype"
          },
          "instanceId": {
            "type": "string",
            "title": "Instanceid"
          },
          "plcId": {
            "type": "string",
            "title": "Plcid"
          },
          "sourceGeneration": {
            "type": "string",
            "title": "Sourcegeneration"
          },
          "registrationRevision": {
            "type": "string",
            "title": "Registrationrevision"
          },
          "createdAt": {
            "type": "string",
            "title": "Createdat"
          },
          "updatedAt": {
            "type": "string",
            "title": "Updatedat"
          }
        },
        "type": "object",
        "required": [
          "sourceType",
          "instanceId",
          "plcId",
          "sourceGeneration",
          "registrationRevision",
          "createdAt",
          "updatedAt"
        ],
        "title": "SourceOut"
      },
      "UpdateIn": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "edit",
              "takeover",
              "delete"
            ],
            "title": "Action"
          },
          "plcId": {
            "type": "string",
            "title": "Plcid"
          },
          "expected": {
            "$ref": "#/components/schemas/ExpectedSource"
          },
          "sourceType": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "daa",
                  "external"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Sourcetype"
          },
          "replacement": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ReplacementSource"
              },
              {
                "type": "null"
              }
            ]
          },
          "confirmTakeover": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confirmtakeover"
          },
          "confirmDelete": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confirmdelete"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action",
          "plcId",
          "expected"
        ],
        "title": "UpdateIn"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
