                      "groups": {
                        "type": "object",
                        "additionalProperties": {
                          "type": "object",
                          "maxProperties": 100,
                          "additionalProperties": {
                            "oneOf": [
                              {
                                "type": "number"
                              },
                              {
                                "type": "string",
                                "maxLength": 4096
                              },
                              {
                                "type": "boolean"
                              }
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Receipt in standard response envelope, including outcome and recordId"
          },
          "401": {
            "description": "Machine identity missing or invalid"
          },
          "403": {
            "description": "Scope denied"
          },
          "409": {
            "description": "Event/sample or contract conflict"
          },
          "413": {
            "description": "Payload exceeds 65536 bytes"
          },
          "415": {
            "description": "Content type must be application/json"
          },
          "422": {
            "description": "Invalid fields, type, scope, timestamp or quality"
          },
          "503": {
            "description": "Target unavailable or commit outcome unknown: retry identical event"
          }
        }
      }
    },
