                  },
                  "mappingId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "mappingRevision": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32
                  },
                  "sourceRefs": {
                    "type": "array",
                    "maxItems": 128,
                    "items": {
                      "type": "object",
                      "required": [
                        "kind"
                      ],
                      "properties": {
                        "kind": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        }
                      },
                      "additionalProperties": true
                    }
                  },
                  "data": {
                    "type": "object",
                    "required": [
                      "equipmentId",
                      "taskNo",
                      "observedAt",
                      "groups",
                      "quality"
                    ],
                    "additionalProperties": false,
