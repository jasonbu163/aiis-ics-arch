                    "data",
                    "errorCode"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "Unavailable or commit unknown",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "code": {
                      "const": 503
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "null"
                    },
                    "errorCode": {
                      "type": "string"
                    }
                  },
                  "type": "object",
                  "required": [
                    "code",
                    "message",
                    "data",
                    "errorCode"
                  ]
                }
              }
            }
          }
        }
      }
    }
