    "/integration/energy/registered-samples": {
      "post": {
        "tags": [
          "Equipment observation"
        ],
        "summary": "Write Registered Energy",
        "operationId": "write_registered_energy_api_v1_integration_energy_registered_samples_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "sourceKey": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.-]{1,64}$"
                  },
                  "target": {
                    "const": "energy"
                  },
                  "observedAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "items": {
                    "additionalProperties": {
                      "additionalProperties": {
                        "properties": {
                          "values": {
                            "additionalProperties": {
                              "type": "number"
                            },
                            "type": "object",
                            "minProperties": 1
                          },
                          "quality": {
                            "enum": [
                              "good",
                              "bad",
                              "unknown",
                              null
                            ]
                          },
                          "intervalStartAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "intervalEndAt": {
                            "type": "string",
                            "format": "date-time"
                          }
                        },
                        "additionalProperties": false,
                        "type": "object",
                        "required": [
                          "values"
                        ]
                      },
                      "type": "object",
                      "minProperties": 1
                    },
                    "type": "object",
                    "minProperties": 1
                  }
                },
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "sourceKey",
                  "target",
                  "observedAt",
                  "items"
                ]
              },
              "example": {
                "sourceKey": "energy-line-01",
                "target": "energy",
                "observedAt": "2026-11-24T12:00:00+08:00",
                "items": {
                  "meter-01": {
                    "electricity": {
                      "quality": "good",
                      "intervalStartAt": "2026-11-24T11:00:00+08:00",
                      "intervalEndAt": "2026-11-24T12:00:00+08:00",
                      "values": {
                        "intervalEnergy": 120
                      }
                    }
                  },
                  "meter-02": {
                    "electricity": {
                      "quality": "good",
                      "values": {
                        "totalEnergy": 9820,
                        "activePower": 0
                      }
                    }
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Stored or replayed batch",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "code": {
                      "const": 200
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "properties": {
                        "sourceKey": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_.-]{1,64}$"
                        },
                        "target": {
                          "const": "energy"
                        },
                        "observedAt": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "outcome": {
                          "const": "stored"
                        },
                        "receiptId": {
                          "type": "string"
                        },
                        "records": {
                          "items": {
                            "properties": {
                              "meterId": {
                                "type": "string"
                              },
                              "groupKey": {
                                "type": "string"
                              },
                              "recordId": {
                                "type": "string"
                              }
                            },
                            "type": "object",
                            "required": [
                              "meterId",
                              "groupKey",
                              "recordId"
                            ]
                          },
                          "type": "array",
                          "minItems": 1
                        }
                      },
                      "type": "object",
                      "required": [
                        "sourceKey",
                        "target",
                        "observedAt",
                        "outcome",
                        "receiptId",
                        "records"
                      ]
                    }
                  },
                  "type": "object",
                  "required": [
                    "code",
                    "message",
                    "data"
                  ]
                },
                "example": {
                  "code": 200,
                  "message": "success",
                  "data": {
                    "sourceKey": "energy-line-01",
                    "target": "energy",
                    "observedAt": "2026-11-24T12:00:00.000000+08:00",
                    "outcome": "stored",
                    "receiptId": "7001",
                    "records": [
                      {
                        "meterId": "meter-01",
                        "groupKey": "electricity",
                        "recordId": "1048"
                      },
                      {
                        "meterId": "meter-02",
                        "groupKey": "electricity",
                        "recordId": "1049"
                      }
                    ]
                  }
                }
              }
            }
          },
          "403": {
            "description": "Source not enabled",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "code": {
                      "const": 403
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
