                    "data",
                    "errorCode"
                  ]
                }
              }
            }
          },
          "415": {
            "description": "Unsupported media type",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "code": {
                      "const": 415
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "null"
                    },
                    "errorCode": {
                      "type": "string"
                    }
                  },
                  "type": "object",
                  "required": [
                    "code",
