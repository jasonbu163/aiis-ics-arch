              "application/json": {
                "schema": {
                  "properties": {
                    "code": {
                      "const": 422
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "null"
                    },
                    "errorCode": {
                      "type": "string"
                    }
                  },
                  "type": "object",
                  "required": [
                    "code",
