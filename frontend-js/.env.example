# ================================================================================
# Syntax
# ================================================================================
# Host development and production build template.
# VITE_* values are public. Restart dev or rebuild dist after changes.
# Use lowercase true/false for boolean flags.
# JSON arrays use outer single quotes and inner double quotes.

# ================================================================================
# API
# ================================================================================
# Browser API base URL; use /api/v1 for same-origin requests.
VITE_API_BASE_URL=/api/v1

# HTTP request timeout in milliseconds.
VITE_REQUEST_TIMEOUT=10000

# ================================================================================
# Development
# ================================================================================
# Vite development proxy target; not the production Nginx upstream.
VITE_PROXY_TARGET=http://127.0.0.1:8000

# Vite development server port.
VITE_APP_PORT=5190

# ================================================================================
# Runtime
# ================================================================================
# Enable local diagnostic mocks only when true; disable for delivery.
VITE_FRONTEND_MOCK_ENABLED=false

# Show demo login hints only when true; disable for delivery.
VITE_LOGIN_DEMO_ACCOUNTS_ENABLED=false

# ================================================================================
# Access
# ================================================================================
# Enabled non-admin leaf pageIds as a JSON array; admin is built in.
VITE_SUPERVISOR_PAGE_ACCESS_JSON='[]'

# JSON pageId array; must be a subset of supervisor grants.
VITE_OPERATOR_PAGE_ACCESS_JSON='[]'

# ================================================================================
# Brand
# ================================================================================
# Bundled filename under src/assets/brand/; invalid or missing files use the demo.
VITE_BRAND_LOGO_FILE=demo-organization-logo.svg

# Logo alignment: left | center | right; default center.
VITE_BRAND_LOGO_ALIGN=center

# Left glow: light | high-light | accent | none; default light.
VITE_BRAND_GLOW_LEFT=light

# Center glow: light | high-light | accent | none; default accent.
VITE_BRAND_GLOW_CENTER=accent

# Right glow: light | high-light | accent | none; default accent.
VITE_BRAND_GLOW_RIGHT=accent
