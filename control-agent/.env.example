# AIIS ICS Control Agent public local template.
#
# Every external capability is disabled below. Copy this file to .env for a
# local dry run, then provide a separately reviewed site configuration before
# enabling any PLC or database gate. Never commit that site configuration.

CONTROL_AGENT_ACCESS_MODE=database
CONTROL_AGENT_BACKEND_BASE_URL=http://127.0.0.1:8000
CONTROL_AGENT_BACKEND_PROBE_PATH=/health

# Public example contracts; replace together with site-owned files.
CONTROL_AGENT_PLC_CONFIG_PATH=config/plc_points.yaml
CONTROL_AGENT_PLC_SNAPSHOT_POLICY_PATH=config/plc_snapshot_policy.yaml

# All PLC access gates are off by default.
CONTROL_AGENT_PLC_ENDPOINT_PROBE_ENABLED=false
CONTROL_AGENT_PLC_HOST=
CONTROL_AGENT_PLC_PORT=
CONTROL_AGENT_PLC_RACK=
CONTROL_AGENT_PLC_SLOT=
CONTROL_AGENT_PLC_CONNECT_TIMEOUT_MS=500
CONTROL_AGENT_PLC_SAMPLE_READ_ENABLED=false
CONTROL_AGENT_PLC_SAMPLE_READ_AUTOSTART=false
CONTROL_AGENT_PLC_DRIVER=rust_snap7
CONTROL_AGENT_PLC_SAMPLE_LIMIT=8
CONTROL_AGENT_PLC_READ_ALLOWED=false
CONTROL_AGENT_PLC_WRITE_ALLOWED=false
CONTROL_AGENT_PLC_AUTOSTART_MODE=stopped
CONTROL_AGENT_PLC_COLLECTION_ENABLED=false
CONTROL_AGENT_PLC_COLLECTION_WRITE_ENABLED=false
CONTROL_AGENT_PLC_COLLECTION_LOOP_ENABLED=false
CONTROL_AGENT_PLC_COLLECTION_LOOP_AUTOSTART=false
CONTROL_AGENT_PLC_COLLECTION_INTERVAL_MS=3000
CONTROL_AGENT_PLC_COLLECTION_MAX_CONSECUTIVE_FAILURES=10
CONTROL_AGENT_PLC_COLLECTION_COLLECTOR_KEY=control-agent-plc
CONTROL_AGENT_PLC_COLLECTION_DEVICE_ID=1
CONTROL_AGENT_PLC_CONTRACT_VERSION=local
CONTROL_AGENT_PLC_RAW_HOT_RETENTION_DAYS=7

# Database access is off and the URL is intentionally blank.
CONTROL_AGENT_DATABASE_ENABLED=false
CONTROL_AGENT_DATABASE_URL=
CONTROL_AGENT_DATABASE_READ_ONLY=true
CONTROL_AGENT_DATABASE_CONNECT_TIMEOUT_MS=1500

# Local diagnostics only; no customer log path is implied.
CONTROL_AGENT_EXECUTOR_ID=control-agent-local
CONTROL_AGENT_STRUCTURED_LOGS_ENABLED=true
CONTROL_AGENT_FILE_LOGS_ENABLED=false
CONTROL_AGENT_LOG_DIR=logs/control-agent
CONTROL_AGENT_LOG_LEVEL=info
CONTROL_AGENT_LOG_FORMAT=jsonl
CONTROL_AGENT_LOG_ROTATION=daily
CONTROL_AGENT_AUDIT_LOG_ENABLED=true

# Optional authorization boundary self-test stays local and side-effect free.
CONTROL_AGENT_UPPER_SYSTEM_AUTH_ENABLED=false
CONTROL_AGENT_UPPER_SYSTEM_AUTH_URL=
CONTROL_AGENT_UPPER_SYSTEM_AUTH_TIMEOUT_MS=2000
CONTROL_AGENT_HIGH_RISK_AUTH_REQUIRED=true
CONTROL_AGENT_AUTH_SELF_TEST_ENABLED=true
CONTROL_AGENT_AUTH_SELF_TEST_PROVIDER=local_mock
CONTROL_AGENT_AUTH_SELF_TEST_OPERATOR_ID=local-self-test
CONTROL_AGENT_AUTH_SELF_TEST_ACTION_SCOPE=authorization.self_test
CONTROL_AGENT_AUTH_SELF_TEST_RESOURCE_ID=control-agent
CONTROL_AGENT_AUTH_SELF_TEST_PAYLOAD_HASH=sha256:self-test-payload
CONTROL_AGENT_AUTH_SELF_TEST_APPROVAL_ID=local-self-test-approval
