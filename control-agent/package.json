{
  "name": "aiis-ics-control-agent",
  "version": "0.1.0",
  "description": "AIIS ICS Control Agent Tauri console",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 15190",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 14190",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --features rust-snap7-driver",
    "tauri:dev:snap7": "tauri dev --features rust-snap7-driver",
    "tauri:build": "tauri build",
    "tauri:build:snap7": "tauri build --features rust-snap7-driver",
    "plc:collect-once": "cargo run --quiet --bin aiis-ics-control-agent --manifest-path src-tauri/Cargo.toml --features rust-snap7-driver -- --ca-collect-plc-snapshots-once",
    "plc:collect-loop": "cargo run --quiet --bin aiis-ics-control-agent --manifest-path src-tauri/Cargo.toml --features rust-snap7-driver -- --ca-collect-plc-snapshots-loop",
    "plc:collect-loop-smoke": "cargo run --quiet --bin aiis-ics-control-agent --manifest-path src-tauri/Cargo.toml --features rust-snap7-driver -- --ca-smoke-plc-collection-loop",
    "plc:runtime": "cargo run --quiet --bin aiis-ics-control-agent-runtime --manifest-path src-tauri/Cargo.toml --features rust-snap7-driver"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@tauri-apps/api": "^2.11.1",
    "element-plus": "^2.14.2",
    "vue": "^3.4.21",
    "vue-i18n": "^9.14.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@vitejs/plugin-vue": "^5.0.4",
    "typescript": "^5.4.5",
    "vite": "^5.1.6",
    "vue-tsc": "^2.0.6"
  }
}
